# .gitignore for Stockpile Mod
# Author: Lille
# 
# This file excludes build artifacts, IDE files, and development files
# from version control.

# ============================================
# Gradle Build Files
# ============================================

# Gradle cache and build outputs - regenerated on each machine
.gradle/
build/
out/
bin/

# ============================================
# Minecraft Development
# ============================================

# Minecraft runtime directory (created when testing)
run/

# Generated resources (copy to src/main/resources when ready)
src/generated/

# ============================================
# IDE & Editor Files
# ============================================

# Eclipse
.classpath
.project
.settings/
.eclipse/

# IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws

# VS Code (keep launch.json but ignore other configs)
.vscode/*
!.vscode/launch.json

# ============================================
# Operating System Files
# ============================================

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory

# ============================================
# Temporary & Backup Files
# ============================================

# Logs
*.log

# Temporary files
*.tmp
*.bak
*.swp
*.swo
*~

# ============================================
# Compiled & Package Files
# ============================================

# Compiled class files
*.class

# Package files
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Don't ignore gradle wrapper jar (needed for builds)
!gradle/wrapper/gradle-wrapper.jar

# ============================================
# Development Notes (Optional)
# ============================================

# Personal notes (remove these lines if you want to commit them)
NOTES.md
PRIVATE_TODO.md
